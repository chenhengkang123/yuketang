{
  "manifest_version": 3,
  "name": "雨课堂作业对答案",
  "version": "1.3.0",
  "description": "在雨课堂学习空间作业页，对照本地题库显示参考答案，并自动选中选择题、填入填空（不提交）",
  "content_scripts": [
    {
      "matches": [
        "*://*.yuketang.cn/ai-workspace/*",
        "*://*.yuketang.cn/v2/web/cloud/student/exercise*"
      ],
      "js": ["bank.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
